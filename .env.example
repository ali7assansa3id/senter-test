# نسخة من هذا الملف باسم .env (أو مرّرها كمتغيرات بيئة في الاستضافة). لا تضع القيم الحقيقية في المستودع.

# الخادم
PORT=3000
# مفتاح توقيع التوكنات. مطلوب في الإنتاج (لو لم يُضبط يُولَّد في ملف .secret — يُفقد عند إعادة بناء الحاوية)
SECRET=

# التخزين
DB_FILE=./senter.db
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups

# الذكاء الاصطناعي (اختياري — بدونه تعيد الميزة 503)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# مشرف المنصة الأول (يُنشأ مرة واحدة إن لم يوجد). كلمة المرور 8 أحرف على الأقل.
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# وكلاء عكسيون موثوقون (عناوين مفصولة بفواصل). لا تضعها إلا إن كان التطبيق خلف nginx أو مشابه.
TRUSTED_PROXIES=
